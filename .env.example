# --- Database ---
DATABASE_URL="postgresql://ixoris:ixoris@localhost:5432/ixoris_erp"

# --- Redis (cache, pub/sub temps réel, sessions) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# OBLIGATOIRE : l'API refuse de démarrer si cette valeur est absente ou encore
# "change-me" (protection contre un déploiement avec un secret JWT connu de
# tous, qui permettrait de forger des jetons d'accès pour n'importe quel
# compte). Générer une vraie valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# --- API ---
API_PORT=4000
WS_PORT=4001
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# --- Frontend (apps/web, apps/pos, apps/delivery) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# --- Notifications CRM (relances impayés / marketing) ---
# "live" active l'envoi réel (Email + SMS/WhatsApp via Twilio) ; toute autre
# valeur (ou absente) garde le mode "log" par défaut, qui journalise sans
# jamais contacter de vrais clients — utile en dev/démo.
NOTIFICATION_MODE="log"

# Email (SMTP standard — SendGrid, Mailgun, une boîte pro, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# SMS / WhatsApp (Twilio — https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# --- Agent IA Local (packages/local-ai) ---
# Optionnel. Adresse d'un serveur Ollama (ou compatible : llama.cpp `server`,
# LM Studio) tournant SUR LA MÊME MACHINE que l'API. S'il répond, l'assistant
# de l'onglet Aide génère ses réponses avec le modèle installé (voir README,
# section "Agent IA Local", pour l'installation d'Ollama). S'il ne répond pas
# — valeur par défaut sans rien installer — l'assistant bascule automatiquement
# sur le moteur RAG léger (recherche documentaire sans génération de texte),
# sans erreur ni configuration supplémentaire requise.
OLLAMA_BASE_URL="http://localhost:11434"
